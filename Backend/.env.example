PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed origins. Leave unset for local dev (falls
# back to allowing any origin). In production, set this to your deployed
# frontend's real origin(s) -- e.g. https://app.example.com. A Capacitor
# Android/iOS build typically requests from https://localhost unless
# capacitor.config.ts sets a custom server.hostname, so include that too if
# you're serving the native app from this backend.
# CORS_ORIGIN=https://app.example.com,https://localhost

# MySQL/MariaDB connection. The backend connects directly to this database --
# there is no local/file-based fallback, so all of these are required.
DB_HOST=localhost
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
DB_PORT=3306

# Email delivery for /auth/forgot-password, via Resend (resend.com --
# sign up, verify a sending domain, and create an API key). Both required
# together, or the reset link is just logged to the server console instead
# of emailed -- fine for local dev, not for real users.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Origin the frontend is actually reachable at, used to build the link
# inside password-reset emails (.../reset-password-new?token=...).
# Defaults to http://localhost:8100, `ionic serve`'s default -- set this to
# wherever the Angular build is actually hosted once it has a public URL,
# or the emailed link won't open anywhere real for a user outside your dev
# machine. (The native Android/iOS app doesn't need this itself; only the
# link a person taps from their email client does.)
# PUBLIC_APP_URL=https://app.whatshouldweeat.app

# Twilio (twilio.com) SMS, used to text a restaurant when someone books
# seats there (see src/lib/sms.js and src/lib/restaurantNotify.js). Sign up,
# get a phone number, and find these on the Twilio Console dashboard. All
# three required together, or the SMS side of the booking notice is just
# skipped -- the email side (RESEND_API_KEY above) still goes out on its
# own, and either way the booking itself always succeeds regardless of
# whether the restaurant has contact info at all (see the restaurants
# table's contact_email/contact_phone columns, both nullable).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Path to a Firebase Admin SDK service-account key JSON file, used to send
# push notifications (see src/lib/push.js) -- Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key. Defaults to
# firebase-service-account.json in this directory (gitignored -- it's a full
# backend credential, never commit it). Optional: without it, notifications
# still work in-app (the `notifications` table + GET /api/notifications),
# they just don't also arrive as a device push.
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Google Places API key, used to fetch each restaurant's actual real-world
# photo (see src/lib/restaurantPhotos.js's getGooglePlacePhoto) AND its real
# phone number + website (see src/lib/googlePlacesContact.js) -- the website
# is then scraped for a contact email, since Google Places has no email field
# of its own (see src/lib/emailScraper.js). Needs a Google Cloud project with
# billing enabled and the "Places API" enabled -- console.cloud.google.com ->
# APIs & Services -> Credentials -> Create Credentials -> API key, then
# restrict it to "Places API" only. Optional: when unset, restaurants fall
# back to OSM's own linked photo/contact tags, then a cuisine-matched stock
# photo from Openverse for the photo (all free, no key needed) -- and simply
# have no phone/email if OSM didn't have them either. Run
# scripts/backfill-restaurant-contact-from-google.mjs after setting this to
# fill in contact info for restaurants already imported.
# GOOGLE_PLACES_API_KEY=

# The Firebase project's "Web" OAuth client ID (ends in
# .apps.googleusercontent.com), used to verify /auth/google's incoming
# Google ID tokens. Firebase Console -> Authentication -> Sign-in method ->
# Google -> enable it, which creates this client. Must exactly match
# Dinner-ionic's environment.ts googleWebClientId (same value, both sides).
# Optional: unset, /auth/google responds 501 instead of the button silently
# failing or accepting tokens it can't actually verify.
# GOOGLE_WEB_CLIENT_ID=

# Face++ (faceplusplus.com) Compare API key/secret -- console.faceplusplus.com
# -> API Key Management -> Create API Key (free tier: 1 request/sec, 1000
# free calls/month at time of writing). Used to automatically compare a
# user's selfie against their uploaded ID photo at /verification/me/submit
# (see src/lib/faceMatch.js). Both required together. Optional: when unset,
# a submission just stays 'pending' the way it always did (no automated or
# manual reviewer ever moves it out of that state -- there's no admin
# panel for this yet).
# FACEPP_API_KEY=
# FACEPP_API_SECRET=

# Public origin this backend is reachable at, used to build absolute URLs
# for the self-hosted images at /images (restaurant/dish photos -- see
# scripts/download-restaurant-images.mjs). Defaults to
# http://localhost:$PORT, which is correct for local dev but MUST be set to
# the real deployed origin (e.g. https://api.whatshouldweeat.app) once this
# backend has one, or every image URL stored in the database will point at
# someone's laptop.
# PUBLIC_ASSET_BASE_URL=https://api.whatshouldweeat.app

# Payment gateways for /api/subscriptions/checkout. All optional -- a
# provider whose vars are unset simply responds 503 "not connected yet" at
# checkout instead of failing to start. Set only the ones you have merchant
# credentials for. See src/lib/paymentGateways/ for what each one does with
# these.

# JazzCash Merchant Portal -> Integration -> Mobile Wallet (MWALLET)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_ENV=sandbox

# EasyPaisa merchant onboarding (Open API / Mobile Account)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
# EASYPAISA_ENV=sandbox

# Whichever card/bank aggregator you contract with (1Link, PayFast Pakistan,
# Safepay, or a specific bank's own gateway) -- see bankGateway.js for the
# generic hosted-checkout shape this expects.
# BANK_GATEWAY_MERCHANT_ID=
# BANK_GATEWAY_SECRET=
# BANK_GATEWAY_BASE_URL=

# Google Gemini API key (aistudio.google.com/apikey -- free, no billing
# setup needed), used for the two real AI features: a written reason on top
# of a person-match (see explainMatch in src/lib/ai.js, called from
# matchesRouter in profile.js) and picking a restaurant for a whole group of
# friends at once (see pickRestaurantForGroup, called from POST
# /api/restaurants/group-recommendation). Both are asked to choose/explain
# only from facts or candidates this backend already computed -- never to
# invent a restaurant or a fact about a person -- so a bad response can
# only fall back to the existing heuristic, never send anyone somewhere
# made up. Optional: unset, both features keep working exactly as before
# this was added, just with the plain heuristic reason/pick instead of a
# model-written one.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# DEV ONLY. Makes every payment method type "succeed" instantly with no real
# processor involved, so checkout can be tested end-to-end before any real
# merchant account exists -- no money ever moves. server.js refuses to start
# if this is true while NODE_ENV=production, so it can't reach real users.
# Leave unset/false everywhere except your own local machine.
# PAYMENT_MOCK_MODE=true
