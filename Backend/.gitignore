node_modules/
.env
# Firebase Admin SDK credential for sending push notifications -- a full
# backend credential (can send push to any user, impersonate the service
# account), never commit it. See scripts/README or .env.example.
firebase-service-account.json
data/
backend.log
backend_live.log
backend_start.log

# Auto-generated photo cache for real (OpenStreetMap-imported) restaurants --
# see src/lib/restaurantPhotos.js. Regenerated on demand from OpenStreetMap
# tags / Openverse in any environment, keyed by cuisine_stock_photos /
# restaurants.external_id in the database, so committing them would just be
# a snapshot of whichever cuisines this dev machine happened to look up.
src/assets/images/restaurants/cuisine-*.jpg
src/assets/images/restaurants/osm-*.jpg

# Same reasoning, for dish photos -- see scripts/fetch-dish-photos.mjs.
# Regenerable from Openverse, keyed by dishes.id in the database.
src/assets/images/dishes/dish-*.jpg
