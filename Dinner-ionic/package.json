{
  "name": "dastarkhan",
  "version": "1.0.0",
  "author": "What Should We Eat?",
  "description": "What Should We Eat? - a premium Pakistani communal dining companion app.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run verify:icons && ng build",
    "watch": "ng build --watch --configuration development",
    "build:icons": "python tools/subset-icons.py",
    "verify:icons": "python tools/subset-icons.py --check",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-social-login": "^8.5.8",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@ionic/angular": "^8.4.0",
    "ionicons": "^7.4.0",
    "material-symbols": "^0.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0",
    "@ionic/cli": "^7.2.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^18.4.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.68.0"
  }
